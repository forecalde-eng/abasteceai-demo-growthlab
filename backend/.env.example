# Solo para el backend local. Este archivo NO lleva valores reales; copia a `.env` (ignorado por git).
# Los secretos viven únicamente aquí (AGENTS.md, regla 3).

# Conexión a la base: Dashboard → Connect → Session pooler, puerto 5432.
# Añade `?sslmode=require`. NO uses el modo transacción (6543).
DATABASE_URL=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SCHEMA=abastece

# Orígenes del frontend permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173

# IA: apagada por defecto. Con false, Jev responde con db/jev_respuesta_SIMULADA.json (SIMULADO).
AI_CALLS_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2
