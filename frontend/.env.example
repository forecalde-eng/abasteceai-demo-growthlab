# Copia desde db/config_frontend.env.example (J-0.1).
# La URL y la publishable key de Supabase pueden ir en el frontend con RLS.
# Nunca agregar claves secretas, OPENAI_API_KEY, TYPESAFE_API_KEY u ORS_API_KEY aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BACKEND_URL=http://localhost:8000

# Mientras src/data/ (David) no tenga hooks reales, los componentes usan fixtures.
# Ver docs/06_PLAN_EQUIPO.md §3 C2.
VITE_USE_MOCKS=true

# --- Cambio rápido de cuenta (J-3.2, solo dev) ---
# Contraseñas de las 7 cuentas demo de Supabase Auth. Van SOLO en frontend/.env.local:
# son secretos y este .example SÍ se versiona. Aún no hay login real (J-0.3), así que
# no hacen falta para la demo con mocks. El email se deriva del rol
# (`<rol>@abasteceai.example`) y se puede sobreescribir con VITE_DEMO_EMAIL_<ROL>.
# Ver src/app/dev/cuentasDemo.ts.
# VITE_DEMO_PASSWORD_AUXILIAR=
# VITE_DEMO_PASSWORD_SUPERVISOR=
# VITE_DEMO_PASSWORD_ADMINISTRADOR=
# VITE_DEMO_PASSWORD_BODEGA=
# VITE_DEMO_PASSWORD_LOGISTICA=
# VITE_DEMO_PASSWORD_COMPRAS=
# VITE_DEMO_PASSWORD_GERENCIA=
